# Copiar a .env y completar:  cp .env.example .env
#
# ── Obligatorio ─────────────────────────────────────────────────────────────
# Dominio (o subdominio) que apunta con un registro A/AAAA a la IP del VPS.
# Las passkeys quedan atadas a este nombre: si lo cambiás después, hay que
# volver a registrarlas.
DOMAIN=gym.example.com

# Correo para Let's Encrypt (avisos de renovación del certificado).
ACME_EMAIL=you@example.com

# ── Acceso ─────────────────────────────────────────────────────────────────
# El primer perfil que se cree pasa a ser admin. Creá el tuyo apenas levantes
# el servidor, antes de compartir la dirección.
FIRST_USER_ADMIN=1

# Para una instancia personal: sin modo invitado y con registro solo por
# invitación (las invitaciones se generan desde el panel de admin).
# Dejá INVITE_ONLY comentado hasta haber creado tu perfil.
ALLOW_GUEST=0
# INVITE_ONLY=1

# ── Opcional ───────────────────────────────────────────────────────────────
# Idioma por defecto de la pantalla de inicio y de los perfiles nuevos.
DEFAULT_LANG=es

# Duración de una sesión, en días.
# SESSION_DAYS=90

# Contacto para los servicios de push (por defecto se usa https://DOMAIN).
# VAPID_SUBJECT=mailto:you@example.com

# Fotos y videos de ejercicios propios: espacio por perfil, en MB.
# MEDIA_QUOTA_MB=200

# El resto de las variables de openGym también funcionan acá:
# https://github.com/DuarteSantos8/openGym/blob/main/.env.example

# ── Respaldos (scripts/backup.sh) ──────────────────────────────────────────
# Cuántos días de respaldos locales se conservan.
BACKUP_KEEP_DAYS=14
# Remoto de rclone para copiar cada respaldo fuera del VPS (ej. "b2:mi-bucket/opengym").
# Vacío = solo respaldos locales en ./backups.
BACKUP_RCLONE_REMOTE=
